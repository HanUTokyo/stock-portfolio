# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_portfolio
DB_USERNAME=stock_user
DB_PASSWORD=stock_password

# Backend runtime
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# Optional bearer protection. Never commit a real token.
APP_AUTH_ENABLED=false
APP_API_TOKEN=

# Market data and valuation jobs
PRICING_TIMEZONE=America/New_York
PRICING_OPEN_CRON=0 35 9 * * MON-FRI
PRICING_CLOSE_CRON=0 5 16 * * MON-FRI
PRICING_RETRY_MAX_ATTEMPTS=3
PRICING_RETRY_BACKOFF_MS=1000
FUNDAMENTALS_BACKFILL_MISSING_ENABLED=true
FUNDAMENTALS_BACKFILL_MISSING_CRON=0 30 3 * * *
FUNDAMENTALS_BACKFILL_MISSING_YEARS=15
FRED_CPI_CRON=0 15 4 * * *
VALUATION_ENGINE_VERSION=valuation-java-2.0.0
VALUATION_EQUITY_RISK_PREMIUM=5.0
